# Copy to .env (never commit it). Names only: fill the values in your copy.

# Public (they reach the browser). Anon key only; access is limited by RLS policies.
# Without these two the site still works, with the sample catalog.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: final domain, no trailing slash. Used for the sitemap at build time.
VITE_SITE_URL=
